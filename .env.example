# ─── SMPP Telco Gateway Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your real credentials.
# NEVER commit your real .env to version control.

# ─── Redis (connection string supports both single-node and cluster) ─────────
# Single node:  redis://localhost:6379
# Cluster:      redis://host1:6379,host2:6379,host3:6379
# With auth:    redis://:password@host1:6379,host2:6379
# TLS:          rediss://...
# If REDIS_URL is not set, falls back to REDIS_HOST/REDIS_PORT/REDIS_PASSWORD
REDIS_URL=localhost:6379

# ─── Kafka (comma-separated broker list) ─────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sms-gateway-core

# MTN Nigeria
MTN_HOST=smpp.mtn.net.ng
MTN_PORT=2775
MTN_SYSTEM_ID=your_mtn_system_id
MTN_PASSWORD=change_me

# Airtel Nigeria
AIRTEL_HOST=smpp.airtel.com.ng
AIRTEL_PORT=2775
AIRTEL_SYSTEM_ID=your_airtel_system_id
AIRTEL_PASSWORD=change_me

# Glo Mobile
GLO_HOST=smpp.glo.com.ng
GLO_PORT=2775
GLO_SYSTEM_ID=your_glo_system_id
GLO_PASSWORD=change_me

# 9mobile (Etisalat)
NINEMOBILE_HOST=smpp.9mobile.com.ng
NINEMOBILE_PORT=2775
NINEMOBILE_SYSTEM_ID=your_9mobile_system_id
NINEMOBILE_PASSWORD=change_me

# ─── Redis (fallback — REDIS_URL takes precedence) ───────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sms_gateway

# ─── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_key_min_32_chars
JWT_EXPIRY=24h

# ─── API Server ─────────────────────────────────────────────────────────────
API_PORT=8081

# ─── Payment Gateway Keys ────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_change_me
PAYSTACK_PUBLIC_KEY=pk_test_change_me

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_change_me
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_change_me

MONNIFY_API_KEY=change_me
MONNIFY_SECRET_KEY=change_me
MONNIFY_CONTRACT_CODE=change_me

# ─── Aggregator: Termii (OTP/Transactional) ──────────────────────────────
# Get API keys from https://developers.termii.com/
TERMII_API_KEY=change_me
TERMII_SECRET_KEY=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_SENDER_ID=SMSAlert
TERMII_TIMEOUT_MS=5000
TERMII_MAX_RETRIES=2
TERMII_COST_PER_SEGMENT=65

# ─── Aggregator: BulkSMS Nigeria (Promotional) ────────────────────────────
# Get credentials from https://www.bulksmsnigeria.com/
BULKSMS_USERNAME=change_me
BULKSMS_PASSWORD=change_me
BULKSMS_BASE_URL=https://www.bulksmsnigeria.com/api/v1
BULKSMS_SENDER_ID=SMSNotify
BULKSMS_TIMEOUT_MS=10000
BULKSMS_MAX_RETRIES=3
BULKSMS_COST_PER_SEGMENT=40

# ─── Route Intent Mapping ─────────────────────────────────────────────────
# Which provider handles each message intent
ROUTE_TRANSACTIONAL_PROVIDER=termii
ROUTE_PROMOTIONAL_PROVIDER=bulksms
ROUTE_FALLBACK_PROVIDER=termii

# ─── SMS Gateway Constants ──────────────────────────────────────────────────
SLIDING_WINDOW_SIZE=128
MAX_CONCURRENT_SESSIONS=30
HEARTBEAT_INTERVAL_MS=30000
RECONNECT_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=30000
